<Window x:Class="ArticulationExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ArticulationExplorer"
        mc:Ignorable="d"
        Title="Articulation Explorer" 
        Height="450" 
        Width="800"
        WindowState="Maximized"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown"
        Focusable="True">

    <Window.Resources>

        <Style x:Key="MatrixCellStyle" TargetType="DataGridCell">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Padding" Value="8"/>

            <Style.Triggers>

                <DataTrigger Binding="{Binding Content.Text, RelativeSource={RelativeSource Self}}" Value="1">
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>

            </Style.Triggers>
        </Style>

        <Style x:Key="NormalDisabledDataGrid" TargetType="DataGrid">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="Foreground" Value="Black"/>
                    <Setter Property="Background" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Background="LightGray">
            <!-- prepinani grafu a matice -->
            <Button x:Name="ToggleViewButton"
            Content="matice"
            Padding="5"
            Margin="10"
            Click="ToggleView_Click"/>

            <!-- bez krokovani -->
            <Button x:Name="AnalyzeGraphButton" 
                    Content="spustit"
                    Padding="5"
                    Margin="10"
                    Click="AnalyzeGraph_Click"/>

            <Button x:Name="ClearGraphButton"
                    Content="nový graf"
                    Padding="5"
                    Margin="10"
                    Click="ClearGraph_Click"/>

            <!-- s krokovanim -->
            <Button x:Name="StartAlgorithmButton"
                    Content="spustit krokování" 
                    Padding="5" 
                    Margin="10" 
                    Click="StartAlgorithm_Click"/>

            <Button x:Name="StepBackButton"
                    Content="←"
                    FontSize="18"
                    Width="40"
                    Margin="10"
                    Click="StepBackward_Click"/>

            <Button x:Name="StepForwardButton"
                    Content="→"
                    FontSize="18"
                    Width="40"
                    Margin="10"
                    Click="StepForward_Click"/>

            <Button x:Name="ResetAlgorithmButton"
                    Content="konec krokování"
                    Padding="5"
                    Margin="10"
                    Click="ResetAlgorithm_Click"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Canvas x:Name="GraphCanvas"
                        Background="White"
                        Visibility="Visible"/>

                <Grid x:Name="MatrixPanel"
                      Visibility="Collapsed"
                      Margin="10"
                      VerticalAlignment="Top">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="MatrixGrid"
                              Grid.Row="0"
                              Style="{StaticResource NormalDisabledDataGrid}"
                              AutoGenerateColumns="True"
                              IsReadOnly="True"
                              HeadersVisibility="All"
                              GridLinesVisibility="All"
                              SelectionMode="Single"
                              SelectionUnit="Cell"
                              CellStyle="{StaticResource MatrixCellStyle}"
                              PreviewMouseRightButtonDown="MatrixGrid_MouseRightButtonDown"
                              MaxHeight="600"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              EnableRowVirtualization="False"
                              EnableColumnVirtualization="False"/>

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                Margin="0,10,0,0">

                        <Button x:Name="AddNodeFromMatrixButton"
                                Content="+"
                                Padding="13.5,5,13.5,5"
                                Margin="0,0,15,0"
                                Click="AddNodeFromMatrix_Click"/>

                        <Button x:Name="RemoveNodeFromMatrixButton"
                                Content="-"
                                Padding="15,5,15,5"
                                Click="RemoveNodeFromMatrix_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <Border Grid.Column="1"
                    MinWidth="180"
                    MaxWidth="360"
                    Background="#F0F0F0"
                    BorderBrush="#D0D0D0"
                    BorderThickness="1">

                <TextBlock x:Name="InfoText"
                           Margin="10"
                           TextWrapping="Wrap"
                           FontFamily="Consolas"
                           VerticalAlignment="Top"/>
            </Border>

        </Grid>
    </Grid>
</Window>